# Read the documentation before extending the defaults:
# https://docs.searxng.org/admin/settings/

use_default_settings: true

server:
  secret_key: "CHANGE_ME"
  image_proxy: true

search:
  formats:
    - html
    - json

engines:
  - name: braveapi
    engine: braveapi
    api_key: "CHANGE_ME"
    inactive: false
  - name: brave
    disabled: true
  - name: exaapi
    engine: exaapi
    api_key: "CHANGE_ME"
    inactive: false
  - name: core.ac.uk
    api_key: "CHANGE_ME"
    inactive: false
