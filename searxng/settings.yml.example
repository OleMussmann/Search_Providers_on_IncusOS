# Read the documentation before extending the defaults:
# https://docs.searxng.org/admin/settings/

use_default_settings: true

server:
  secret_key: "CHANGE_ME"
  image_proxy: true

search:
  formats:
    - html
    - json

engines:
  - name: braveapi
    engine: braveapi
    api_key: "CHANGE_ME"
    inactive: false
  - name: brave
    disabled: true
  - name: exaapi
    engine: exaapi
    api_key: "CHANGE_ME"
    inactive: false
  - name: core.ac.uk
    api_key: "CHANGE_ME"
    inactive: false
    # api.core.ac.uk routinely takes 8-15s to answer, so the 3.0s default from
    # `outgoing.request_timeout` times out on every single query. Note this
    # raises the *whole search's* deadline (SearXNG uses the max engine timeout
    # as the overall budget), but core is science-category only, so general
    # searches are unaffected.
    timeout: 20.0
