# Version pins for incus-compose-update. Image refs in compose.yaml
# interpolate these; check/apply reads and writes them. Tracked in git.
# Secrets stay in .env (gitignored).
#
# Pin targets verified 2026-08-06. Registries move; the next `check` will
# report whatever is currently newest.

# Firecrawl API — plain semver tags (no `v` prefix), exclude `-production`
# and `sha-*` arch tags.
FIRECRAWL_TAG=2.11.291

# SearXNG — `order: pushed` in x-update: the newest tag is whatever Docker
# Hub reports as most recently updated, not the highest date in the name.
SEARXNG_TAG=2026.8.29-d226b78bc

# Firecrawl playwright service — only `latest` + arch tags exist, so pin by
# digest of `latest`. Image ref keeps the `latest` label for humans.
PLAYWRIGHT_SERVICE_DIGEST=sha256:df1a393ce8bfc3801570a826a9b0dcc400ae48789adb4a0ad9d6cbf0229b059b

# Firecrawl NUQ Postgres — same as playwright-service: digest of `latest`.
# Both nuq-postgres and nuq-init interpolate this variable.
NUQ_POSTGRES_DIGEST=sha256:aed86f62858f29bd971abddcdeb301c12888098d2cf5d33c1ba42b053bc460f6

# Redis — literal pin, no x-update: block (unmanaged by the updater).
REDIS_TAG=8.10.0-alpine

# RabbitMQ — stays on 3-management for now; major-version migration is a
# separate project, not a pin decision. Unmanaged.
RABBITMQ_TAG=3-management
